  "ambient_pools": {
    "astronaut_thought": [
      "ambient.thought.1",
      "ambient.thought.2"
    ],
    "science_fact": [
      "ambient.science.1",
      "ambient.science.2"
    ]
  },
  "build_sites": {
    "tunnel": [
      15,
      17
    ],
    "laboratory": [
      15,
      18
    ],
    "solar_panel": [
      10,
      18
    ],
    "battery": [
      10,
      21
    ]
